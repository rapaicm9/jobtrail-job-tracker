# Environment for the generated docker-compose.yaml.
#
# Copy to `.env` next to the compose file on the deployment host and fill in
# real values. The real `.env` is git-ignored and must never be committed - the
# secrets below belong on the host only.
#
#   cp .env.example .env && edit .env
#
# The compose topology is regenerated with `aspire publish`; keep any new
# variables it introduces mirrored here.

# Images built and pushed by CI (e.g. ghcr.io/<owner>/jobspect-api:<tag>).
API_IMAGE=
WORKER_IMAGE=
MIGRATIONS_IMAGE=

# Port the API listens on inside its container / behind the reverse proxy.
API_PORT=8080

# Backing-service credentials. Generate strong, unique values per environment;
# do not reuse across deployments. These are the crown jewels - host-only.
POSTGRES_PASSWORD=
CACHE_PASSWORD=

# The ES256 (P-256) keypair every access token is signed and validated with. One
# pair per environment - a pair reused from another deployment would let its
# tokens authenticate here. Mint one with:
#
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out jwt.key
#   openssl ec -in jwt.key -pubout -out jwt.pub
#
# Both values are multi-line PEM. Compose reads a `.env` line-by-line, so the
# newlines have to survive the transport - quote the value and keep it on one
# line, or supply these two variables to the compose process from the host's own
# secret store instead of this file. Rotating the pair invalidates every access
# token in circulation; refresh tokens are unaffected, so clients recover on
# their next refresh.
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=

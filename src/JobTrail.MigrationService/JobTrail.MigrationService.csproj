<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A one-shot, not a service: it runs to completion and exits. Deliberately
         not the Worker SDK, which would suggest something long-lived. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every module, because every module owns a schema. It composes them to reach
      the migrator each one registers; it never touches a DbContext, which stays
      internal to its module.
    -->
    <ProjectReference Include="..\JobTrail.Infrastructure\JobTrail.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\JobTrail.Modules.Identity\JobTrail.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Billing\JobTrail.Modules.Billing\JobTrail.Modules.Billing.csproj" />
    <ProjectReference Include="..\Modules\Applications\JobTrail.Modules.Applications\JobTrail.Modules.Applications.csproj" />
    <ProjectReference Include="..\Modules\Analytics\JobTrail.Modules.Analytics\JobTrail.Modules.Analytics.csproj" />
    <ProjectReference Include="..\Modules\Notifications\JobTrail.Modules.Notifications\JobTrail.Modules.Notifications.csproj" />
  </ItemGroup>

</Project>

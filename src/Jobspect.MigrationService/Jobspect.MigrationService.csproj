<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A one-shot, not a service: it runs to completion and exits. Deliberately
         not the Worker SDK, which would suggest something long-lived. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every module, because every module owns a schema. It composes them to reach
      the migrator each one registers; it never touches a DbContext, which stays
      internal to its module.
    -->
    <ProjectReference Include="..\Jobspect.Infrastructure\Jobspect.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\Jobspect.Modules.Identity\Jobspect.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Billing\Jobspect.Modules.Billing\Jobspect.Modules.Billing.csproj" />
    <ProjectReference Include="..\Modules\Applications\Jobspect.Modules.Applications\Jobspect.Modules.Applications.csproj" />
    <ProjectReference Include="..\Modules\Analytics\Jobspect.Modules.Analytics\Jobspect.Modules.Analytics.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Jobspect.Modules.Notifications\Jobspect.Modules.Notifications.csproj" />
  </ItemGroup>

</Project>

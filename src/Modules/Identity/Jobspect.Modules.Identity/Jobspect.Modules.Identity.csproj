<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The module defines its own minimal-API endpoints and JwtBearer wiring;
         the framework reference brings in ASP.NET Core without making this a host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The module's types are internal; its own unit tests need to see them. -->
    <InternalsVisibleTo Include="Jobspect.Modules.Identity.Tests" />
    <!-- The integration fixture applies this module's migrations to the
         container database; everything else it does goes over HTTP. -->
    <InternalsVisibleTo Include="Jobspect.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jobspect.Modules.Identity.Contracts\Jobspect.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Billing\Jobspect.Modules.Billing.Contracts\Jobspect.Modules.Billing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Jobspect.SharedKernel\Jobspect.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Jobspect.Infrastructure\Jobspect.Infrastructure.csproj" />
  </ItemGroup>
</Project>
